# =============================================================================
# DataForge .gitignore
# =============================================================================

# --- Environment ---
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.log

# --- Node / React ---
node_modules/
/services/dashboard/frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# --- Data files (too large for git) ---
data/samples/*.root
data/samples/*.hdf5
data/samples/*.parquet
data/samples/*.avro
# Keep placeholder files
!data/samples/.gitkeep

# --- Models (use Git LFS or object storage for large model files) ---
services/ai-ml/anomaly-detection/models/*.pkl
services/ai-ml/anomaly-detection/models/*.pt
services/ai-ml/anomaly-detection/models/*.h5
!services/ai-ml/anomaly-detection/models/.gitkeep

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# --- Docker ---
.docker/
