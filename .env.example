# =============================================================================
# DataForge — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# --- Database ---
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=dataforge_dev        # Change for any shared environment

# --- API ---
API_SECRET_KEY=dev-secret-key-change-in-production

# --- Streaming ---
EVENTS_PER_SECOND=100                  # Synthetic sensor generator rate
WATERMARK_DELAY_SECONDS=5              # Spark watermark window
SPARK_SHUFFLE_PARTITIONS=8             # Spark shuffle partitions (~CPU cores); see M5W20T1
SPARK_MAX_OFFSETS_PER_TRIGGER=50000    # Max Kafka records per micro-batch (0 = unlimited)
# Optional replay start (epoch ms); empty = latest.
# Comment stays on its own line: Compose does NOT strip a trailing comment after
# an EMPTY value, so "VAR=   # note" sets VAR to the comment text itself.
SPARK_STARTING_TIMESTAMP_MS=

# --- Late / out-of-order injection (M6W23T3) — OFF unless set ---
# Lateness is measured against the newest event time already published on the
# same topic, not against wall clock. A fraction of 1.0 with a narrow range
# shifts the whole stream and drops nothing; keep it below 1.0. Drops begin
# beyond the EFFECTIVE watermark, measured at 12-13s in M6W23T4, not at 5s.
SENSOR_LATE_FRACTION=0                 # 0.0-1.0 share of records shifted back
SENSOR_LATE_MIN_MS=0                   # Lower bound of the backward shift
SENSOR_LATE_MAX_MS=0                   # Upper bound of the backward shift
SENSOR_DISORDER_FRACTION=0             # 0.0-1.0 share diverted to a reorder buffer
SENSOR_DISORDER_BUFFER=0               # Buffer size; min 2 when disorder is on
# Optional seed for reproducible runs — own line, see the note above
SENSOR_INJECTION_SEED=
FUSION_PROGRESS_DEBUG=0                # 1 dumps Spark per-batch progress (verbose)

# --- Fusion (M6) ---
FUSION_WINDOW_MS=500                   # Join half-window; written per fused row
FUSION_TRIGGER_SECONDS=5               # Option A baseline; see design note Section 8
FUSION_SHUFFLE_PARTITIONS=8            # Locked into the checkpoint on first write

# --- Kafka Topics (defaults match docker-compose) ---
KAFKA_TOPIC_ALICE=alice-events
KAFKA_TOPIC_RADAR=sensor-radar
KAFKA_TOPIC_LIDAR=sensor-lidar
KAFKA_TOPIC_TELEMETRY=sensor-telemetry
