# =============================================================================
# DataForge — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# --- Database ---
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=dataforge_dev        # Change for any shared environment

# --- API ---
API_SECRET_KEY=dev-secret-key-change-in-production

# --- Streaming ---
EVENTS_PER_SECOND=100                  # Synthetic sensor generator rate
WATERMARK_DELAY_SECONDS=5              # Spark watermark window
SPARK_SHUFFLE_PARTITIONS=8             # Spark shuffle partitions (~CPU cores); see M5W20T1
SPARK_MAX_OFFSETS_PER_TRIGGER=50000    # Max Kafka records per micro-batch (0 = unlimited)
SPARK_STARTING_TIMESTAMP_MS=           # Optional replay start (epoch ms); empty = latest

# --- Kafka Topics (defaults match docker-compose) ---
KAFKA_TOPIC_ALICE=alice-events
KAFKA_TOPIC_RADAR=sensor-radar
KAFKA_TOPIC_LIDAR=sensor-lidar
KAFKA_TOPIC_TELEMETRY=sensor-telemetry
